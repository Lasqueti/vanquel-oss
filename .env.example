# Copy to .env and fill in. Never commit .env.
# A channel turns on when its settings are filled in; leave a block empty to skip it.

# ---- Agent server ----
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=data/agent.sqlite
# The public https URL your tunnel or proxy serves this server on (needed for Twilio signatures).
PUBLIC_BASE_URL=https://agent.example.com
# Long random string. Enables /admin/* (reply as a human, hand back, publish booking slots).
ADMIN_TOKEN=

# ---- The model (any OpenAI-compatible Chat Completions API with tool calls) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Your provider's model id.
LLM_MODEL=

# ---- Who the agent is ----
AGENT_NAME=Assistant
BUSINESS_NAME=Example Dental
# Plain text file with hours, prices, policies, FAQs. The agent only states facts from here or from tools.
BUSINESS_INFO_FILE=business.txt
# IANA time zone, used for reminders and bookings.
TIMEZONE=America/New_York
HISTORY_LIMIT=30
MAX_REPLIES_PER_HOUR=30
REPLY_DEBOUNCE_MS=1500
MAX_TOOL_ROUNDS=5

# ---- iMessage lines ----
# Shared secret between the server and every bridge. Long random string.
BRIDGE_KEY=
# line id = bridge URL, comma separated. The Mac line and each iPhone line.
IMESSAGE_LINES=mac=http://127.0.0.1:3101,phone1=http://127.0.0.1:3201
IMESSAGE_DEFAULT_LINE=mac
# Where bridges post inbound texts.
SERVER_URL=http://127.0.0.1:3000

# ---- Mac line bridge (bridges/mac) ----
MAC_LINE_ID=mac
MAC_BRIDGE_PORT=3101
# imsg (github.com/steipete/imsg) or applescript
MAC_SEND_VIA=imsg
IMSG_PATH=imsg

# ---- SMS through Twilio (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Email through Postmark (optional) ----
POSTMARK_SERVER_TOKEN=
EMAIL_FROM_ADDRESS=help@example.com
# Long random string; the inbound webhook URL is PUBLIC_BASE_URL/channels/email/postmark?token=<this>
EMAIL_INBOUND_TOKEN=

# ---- Slack (optional): customer DMs and/or the human handoff console ----
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Channel id where handoff threads open, for example C0123456789.
SLACK_OPERATOR_CHANNEL=
# Set to 0 to use Slack only as the operator console, not as a customer channel.
SLACK_DM_CHANNEL=1
# If Slack is not set up, handoff notices can go to this address by email (needs Postmark).
OPERATOR_EMAIL=

# ---- Operator alerts (a line is down). A Slack incoming webhook URL. ----
ALERT_SLACK_WEBHOOK_URL=

# ---- Browser worker (optional) ----
BROWSER_WORKER_URL=http://127.0.0.1:3105
BROWSER_WORKER_PORT=3105
# Long random string shared by the server and the worker.
BROWSER_WORKER_SECRET=
WORKER_PROFILES_DIR=data/browser-profiles
WORKER_HEADLESS=0
WORKER_MAX_TASKS=2
WORKER_MAX_STEPS=25
WORKER_TASK_TIMEOUT_MS=480000
# Optional: a different (cheaper or faster) model for browsing.
WORKER_LLM_MODEL=
# Optional: path to Chrome if it is not in the standard place.
CHROME_PATH=
