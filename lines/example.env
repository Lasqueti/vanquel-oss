# One file per iPhone line: copy to lines/<line-id>.env (git ignores it) and
# chmod 600 it. Start the bridge with: npm run bridge:phone -- lines/<line-id>.env
LINE_ID=phone1
# The phone's address on your LAN. Give the phone a fixed DHCP reservation.
SMSERVER_URL=http://PHONE_IP:8741
# The password in the phone's SMServer launch daemon.
SMSERVER_PASSWORD=
# Port this bridge listens on (127.0.0.1 only). Must be unique per line and
# match this line's entry in IMESSAGE_LINES.
PHONE_BRIDGE_PORT=3201
POLL_MS=3000
# 1 if this process cannot reach the phone directly but curl in a terminal can.
SMSERVER_VIA_CURL=0
