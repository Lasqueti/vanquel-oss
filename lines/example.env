# One file per iPhone line: copy to lines/<line-id>.env (git ignores it) and
# chmod 600 it. Start the bridge with: npm run bridge:phone -- lines/<line-id>.env
LINE_ID=phone1
# The phone's address on your LAN. Give the phone a fixed DHCP reservation.
SMSERVER_URL=http://PHONE_IP:8741
# The password in the phone's SMServer launch daemon.
SMSERVER_PASSWORD=
# Port this bridge listens on (127.0.0.1 only). Must be unique per line and
# match this line's entry in IMESSAGE_LINES.
PHONE_BRIDGE_PORT=3201
POLL_MS=3000
# 1 if this process cannot reach the phone directly but curl in a terminal can.
SMSERVER_VIA_CURL=0

# ---- Optional: the phone tweak (ios/tweak/README.md) ----
# Photos, native voice notes, tapbacks, app cards and games need it.
# Leave empty for a text-only line.
# e.g. http://PHONE_IP:8799
TWEAK_URL=
TWEAK_SECRET=
# ssh target used to copy files onto the phone before a photo or voice send, e.g. mobile@PHONE_IP
TWEAK_SSH=
TWEAK_SSH_KEY=
# The Messages app listener used for GamePigeon moves.
# e.g. http://PHONE_IP:8800
TWEAK_GAME_URL=
TWEAK_STAGE_DIR=/var/mobile
# SMServer's websocket (typing indicator). Default ws://<phone>:8740
SMSERVER_SOCKET_URL=
# How the agent server reaches this bridge's /attachment route (photos people send).
PHONE_BRIDGE_PUBLIC_URL=http://127.0.0.1:3201
